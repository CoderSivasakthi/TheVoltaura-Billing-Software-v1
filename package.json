{
  "name": "solar-billing-saas-ui",
  "version": "0.2.0",
  "description": "SolarFlow - Cloud UI with a small Express mock API for local development",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js --watch server.js --watch data --ext js,json",
    "build": "npm run build --prefix frontend",
    "migrate:supabase": "node scripts/supabase-migrate-seed.js",
    "itest:supabase": "NODE_ENV=test node scripts/integration-test.js",
    "seed": "node scripts/seed-data.js",
    "itest": "node scripts/integration-test.js",
    "lint": "eslint . --ext .js",
    "format": "prettier --write .",
    "serve:python": "python -m http.server 8080"
  },
  "keywords": [
    "solar",
    "billing",
    "saas",
    "ui"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.7",
    "bcryptjs": "^2.4.3",
    "chart.js": "^4.5.1",
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "express": "^4.18.2",
    "googleapis": "^173.0.0",
    "jsonwebtoken": "^9.0.3",
    "lucide": "^0.575.0",
    "multer": "^2.2.0",
    "pg": "^8.18.0",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "eslint": "^8.48.0",
    "nodemon": "^2.0.22",
    "prettier": "^2.8.8"
  }
}
