# ═══════════════════════════════════════════════════════════════════════════════
# TheVoltaura Solar ERP — Environment Variables Template
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# ═══════════════════════════════════════════════════════════════════════════════

# ── Node.js Server ────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=5001

# JWT secret — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=CHANGE_ME_USE_STRONG_SECRET_32CHARS_MIN

# ═══════════════════════════════════════════════════════════════════════════════
# SUPABASE (Primary Database)
# Get these from: https://app.supabase.com → Settings → API
# ═══════════════════════════════════════════════════════════════════════════════

# Project URL (from Supabase Dashboard → Settings → API)
SUPABASE_URL=https://your-project.supabase.co

# Anon Key (safe for client-side — but we only use it for table checks)
SUPABASE_KEY=your_supabase_anon_key

# Service Role Key (SERVER ONLY — bypasses RLS — NEVER expose to frontend)
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

# ═══════════════════════════════════════════════════════════════════════════════
# SUPABASE STORAGE (File Storage)
# Setup guide:
#   1. Go to https://app.supabase.com → Project → Storage
#   2. Create a new bucket named 'erp-documents'
#   3. Make sure the bucket is Public (or configure RLS policies as needed)
# ═══════════════════════════════════════════════════════════════════════════════

SUPABASE_BUCKET_NAME=erp-documents

# ═══════════════════════════════════════════════════════════════════════════════
# PUBLIC FRONTEND → BACKEND URL (GitHub Actions secret name: PUBLIC_API_URL)
# Set this to the HTTPS origin of the deployed Node API, e.g. https://thevoltaura-billing.onrender.com
# Do not put secrets in the frontend. The SPA only needs this origin.
# ═══════════════════════════════════════════════════════════════════════════════
# PUBLIC_API_URL=https://your-backend.example.com
CORS_ORIGINS=https://codersivasakthi.github.io

# ═══════════════════════════════════════════════════════════════════════════════
# DOCKER / POSTGRESQL (optional — schema bootstrap only)
# Application data goes through Supabase REST, not a local Postgres container.
# ═══════════════════════════════════════════════════════════════════════════════
DOCKER_DB=false
DATABASE_URL=
